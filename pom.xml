<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>6.2250.va_d01d559a_209</version>
    <relativePath />
  </parent>

  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>

  <artifactId>openid4java</artifactId>
  <version>${changelist}</version>
  <packaging>hpi</packaging>

  <name>OpenID4Java API</name>
  <description>This plugin provides a shared dependency on the openid4java library so that other plugins can co-operate when using this library.</description>
  <url>https://plugins.jenkins.io/openid4java/</url>

  <licenses>
    <license>
      <name>The MIT license</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>stephenc</id>
      <name>Stephen Connolly</name>
      <roles>
        <role>developer</role>
      </roles>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/${gitHubRepo}.git</connection>
    <developerConnection>scm:git:git@github.com:${gitHubRepo}.git</developerConnection>
    <tag>${scmTag}</tag>
    <url>https://github.com/${gitHubRepo}</url>
  </scm>

  <properties>
    <changelist>999999-SNAPSHOT</changelist>
    <gitHubRepo>jenkinsci/openid4java-plugin</gitHubRepo>
    <!-- https://www.jenkins.io/doc/developer/plugin-development/choosing-jenkins-baseline/ -->
    <jenkins.baseline>2.479</jenkins.baseline>
    <artifactId>bom-${jenkins.baseline}.x</artifactId>
    <jenkins.version>${jenkins.baseline}.3</jenkins.version>
    <hpi.bundledArtifacts>commons-codec,openid4java-shaded,openid4java-team-extension</hpi.bundledArtifacts>
    <hpi.strictBundledArtifacts>true</hpi.strictBundledArtifacts>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.jenkins.tools.bom</groupId>
        <artifactId>bom-${jenkins.baseline}.x</artifactId>
        <version>5054.v620b_5d2b_d5e6</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.amarulasolutions</groupId>
      <artifactId>openid4java-shaded</artifactId>
      <version>2.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.cloudbees</groupId>
      <artifactId>openid4java-team-extension</artifactId>
      <version>1.0</version>
      <exclusions>
        <exclusion>
          <groupId>org.openid4java</groupId>
          <artifactId>openid4java-nodeps</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

</project>
